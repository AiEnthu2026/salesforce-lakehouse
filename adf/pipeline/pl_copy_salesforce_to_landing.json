						"referenceName": "ds_sf_account",
						"type": "DatasetReference",
						"parameters": {
							"object": "Account"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_landing_parquet",
						"type": "DatasetReference",
						"parameters": {
							"folder": "landing/salesforce/account/2026-09-29"
