{
	"name": "pl_copy_salesforce_to_landing",
	"properties": {
		"activities": [
			{
				"name": "set_run_date",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "rd",
					"value": {
						"value": "@if(empty(pipeline().parameters.run_date), convertFromUtc(utcnow(), 'AUS Eastern Standard Time', 'yyyy-MM-dd'), pipeline().parameters.run_date)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Copy Account",
				"description": "Copy Account Data from Salesforce",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "set_run_date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.01:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SalesforceV2Source",
						"includeDeletedObjects": false,
						"partitionOption": "AutoDetect",
						"preserveScaleFromSchema": false
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_sf_account",
						"type": "DatasetReference",
						"parameters": {
							"object": "Account"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_landing_parquet",
						"type": "DatasetReference",
						"parameters": {
							"folder": {
								"value": "@concat('landing/salesforce/account/', variables('rd'))",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Copy Contact",
				"description": "Copy Contact data from Salesforce",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "set_run_date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.01:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SalesforceV2Source",
						"includeDeletedObjects": false,
						"partitionOption": "AutoDetect",
						"preserveScaleFromSchema": false
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_sf_account",
						"type": "DatasetReference",
						"parameters": {
							"object": "Contact"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_landing_parquet",
						"type": "DatasetReference",
						"parameters": {
							"folder": {
								"value": "@concat('landing/salesforce/contact/', variables('rd'))",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Copy Case",
				"description": "Copy Case from Salesforce",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "set_run_date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.01:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SalesforceV2Source",
						"includeDeletedObjects": false,
						"partitionOption": "AutoDetect",
						"preserveScaleFromSchema": false
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_sf_account",
						"type": "DatasetReference",
						"parameters": {
							"object": "Case"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_landing_parquet",
						"type": "DatasetReference",
						"parameters": {
							"folder": {
								"value": "@concat('landing/salesforce/case/', variables('rd'))",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"run_date": {
				"type": "string"
			}
		},
		"variables": {
			"rd": {
				"type": "String"
			}
		},
		"annotations": []
	}
}